# Requires: 'repo'
GITHUB_TOKEN=<GitHub access token>

# Requires:
#   Organizations: 'Automattic',
#   REST Scopes: 'write_builds'
BUILDKITE_TOKEN=<Buildkite Personal Access Token>

# Accordion API key, used to look up the audio variants of an episode.
# Optional: without it the audio variant panel stays hidden and the app builds normally.
# Alternatively set `accordionApiKey` in secret.properties.
ACCORDION_API_KEY=<Accordion API key>
